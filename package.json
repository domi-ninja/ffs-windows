{
  "name": "ffs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Small TypeScript CLI with subcommands.",
  "bin": {
    "ffs": "./dist/ffs.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ffs": "node ./dist/ffs.js",
    "test:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./tests/install.tests.ps1",
    "test:cli": "node ./dist/ffs.js dotnet test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "koffi": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
